{
  "name": "eagle-media-preview-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:plugin-service && vite build",
    "build:plugin-service": "tsc -p tsconfig.plugin-service.json",
    "build-storybook": "STORYBOOK=1 HOME=.storybook-home storybook build --disable-telemetry",
    "dev": "vite --host 127.0.0.1",
    "storybook": "STORYBOOK=1 HOME=.storybook-home storybook dev -p 6006 --disable-telemetry",
    "test": "npm run build:plugin-service && vitest run",
    "typecheck": "tsc --noEmit && npm run typecheck:plugin-service",
    "typecheck:plugin-service": "tsc -p tsconfig.plugin-service.json --noEmit",
    "verify": "npm run typecheck && npm run build && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "qrcode-generator": "^1.4.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@storybook/test": "^8.6.14",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "storybook": "^8.6.14",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.6",
    "vitest": "^2.1.8"
  }
}
