{
  "name": "eagle-media-preview-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:plugin-service && vite build",
    "build:plugin-service": "tsc -p tsconfig.plugin-service.json",
    "build-storybook": "STORYBOOK=1 HOME=.storybook-home storybook build --disable-telemetry",
    "dev": "vite --host 127.0.0.1",
    "storybook": "STORYBOOK=1 HOME=.storybook-home storybook dev -p 6006 --disable-telemetry",
    "test": "npm run build:plugin-service && vitest run",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit && npm run typecheck:plugin-service",
    "typecheck:plugin-service": "tsc -p tsconfig.plugin-service.json --noEmit",
    "verify": "npm run build && tsc --noEmit && npm run test:run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.18.0",
    "qrcode-generator": "^1.4.4",
    "radix-ui": "^1.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "shadcn": "^4.11.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.6.18",
    "@storybook/react-vite": "^8.6.18",
    "@storybook/test": "^8.6.18",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "storybook": "^8.6.18",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.6",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
