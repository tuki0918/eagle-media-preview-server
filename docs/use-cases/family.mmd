---
title: USE CASE 2  ·  FAMILY  (a home media library)
---
block-beta
    accDescr: The library lives on the NAS; an always-on host machine opens it in Eagle and serves it to the family.<br>Give each person their own account so that only grown-ups can change ratings and tags.
    columns 3

    block:family["FAMILY DEVICES"]
        columns 1
        you("YOU  ·  Admin<br>laptop<br>organize everything")
        partner("PARTNER  ·  Editor<br>phone<br>rate and tag photos")
        kids("KIDS  ·  Viewer<br>tablet / TV browser<br>*browse and play only*")
    end
    block:host["HOST MACHINE  (always on)"]
        columns 1
        server["MEDIA PREVIEW SERVER<br>✓ Auto start with Eagle<br>✓ Password + 3 users<br>✓ Share only selected libraries<br>*https://media-server.lan:41532*"]
        eagle("EAGLE APP<br>opens the family library")
    end
    block:storage["NAS"]
        columns 1
        photos[("FAMILY LIBRARY<br>Family.library<br>photos, home videos<br>✓ shared")]
        work[("WORK LIBRARY<br>Work.library<br>✕ not shared")]
    end

    you <-->|HTTPS| server
    partner <-->|HTTPS| server
    kids <-->|HTTPS| server
    server -->|edits| eagle
    eagle -->|opens| photos

