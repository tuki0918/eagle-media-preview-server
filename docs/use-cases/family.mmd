title: "FAMILY: a home media library on a NAS"
---
block-beta
    accDescr: Keep the computer running Eagle on, so the family can open the **NAS library** at any time.<br>Give each person **their own account**, so only grown-ups can rate, tag or trash photos.
    columns 3

    block:clients["FAMILY DEVICES"]
        columns 1
        you("YOU (Admin) ── PC<br>Move unwanted photos to Trash")
        partner("PARTNER (Editor) ── Phone<br>Rate and tag favorite photos")
        kids("KIDS (Viewer) ── Tablet or TV<br>Watch home videos")
    end
    block:host["HOST MACHINE (always on)"]
        columns 1
        server["MEDIA PREVIEW SERVER<br>✓ Public Network<br>✓ HTTPS<br>✓ Password protection (3 users)<br>✓ Share only selected libraries<br>*e.g. https://media-server.lan:41532*"]
        eagle("EAGLE APP<br>keep Family.library open")
    end
    block:storage["NAS"]
        columns 1
        library[("FAMILY LIBRARY<br>Family.library<br>photos, home videos<br>✓ shared")]
        work[("WORK LIBRARY<br>Work.library<br>✕ not shared")]
    end

    you <-->|HTTPS| server
    partner <-->|HTTPS| server
    server -->|HTTPS| kids
    server -->|"library info, edits"| eagle
    eagle -->|opens| library

